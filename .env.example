# Required: encrypts GitHub tokens at rest. Changing it makes stored tokens unreadable.
SECRET_KEY=change-me-to-a-long-random-string
# First admin, only used when the database has no user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin
DATABASE_PATH=sumigo.db
PORT=8080
# Set to true when served over HTTPS.
SECURE_COOKIE=false
